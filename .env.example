# Repo-root .env, read by services/telehub/telehub/settings.py (load_dotenv walks up to here).

# Supabase Postgres — telehub's store.
# Pooled (port 6543, ?pgbouncer=true) for normal app traffic.
TELEHUB_DATABASE_URL=postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432) — used instead of the pooled URL only while `manage.py migrate` runs.
TELEHUB_DATABASE_MIGRATE_URL=postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:5432/postgres

# Chat360 outbound dispatch (services/telehub/apps/telehub/services/dispatcher.py).
# The outbound endpoint URL itself lives on the Communication node's config, and the
# DID/caller-ID is per-VoiceBot (VoiceBot.dids) — neither is an env var.
CHAT360_OUTBOUND_BEARER_TOKEN=
CHAT360_AUTH_COOKIE=csrftoken=your_csrftoken_here

# Django. Local dev needs none of these; deployed (Render) sets them.
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=false
# Comma-separated; defaults to http://localhost:3000,http://127.0.0.1:3000
# CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-telehub.onrender.com

# Public base URL shown for webhook endpoints in Settings → Webhooks. When unset, telehub
# falls back to the local ngrok API (NGROK_API_URL, default http://127.0.0.1:4040/api/tunnels).
# PUBLIC_BASE_URL=https://your-telehub.onrender.com
# NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
