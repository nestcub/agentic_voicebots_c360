# LLM Provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Admin client IDs — comma-separated. Admins can teach platform knowledge directly (status=active).
# Production: rewire is_admin() in shared/auth.py to read Chat360's authenticated role claim instead.
ADMIN_CLIENT_IDS=

# Transcription
SARVAM_API_KEY=your_sarvam_api_key_here

# Intelligence API server
INTEL_API_KEY=change-me-strong-random-secret
ALLOWED_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app

# Set in Next.js dashboard (.env.local):
# NEXT_PUBLIC_INTEL_API_URL=http://localhost:8001      # intelligence API (transcribe/converse/plans)
# NEXT_PUBLIC_INTEL_API_KEY=change-me-strong-random-secret
# NEXT_PUBLIC_ORCH_API_URL=http://localhost:8000       # orchestrator API (dashboard reads + goal/CRM writes)
# NEXT_PUBLIC_DATA_SOURCE=api                          # "api" to read live data; omit/"mock" for demo data

# Neon Postgres — the single store for BOTH planes (intelligence + orchestrator).
# Use the POOLED connection string for Railway/Azure.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Embeddings (provider-agnostic — flip these 3 vars + re-run the seeds to switch providers)
EMBEDDING_PROVIDER=gemini                  # gemini | openai
EMBEDDING_MODEL=gemini-embedding-001       # openai later: text-embedding-3-small
EMBEDDING_DIM=768                          # openai later: 1536
GOOGLE_API_KEY=your_google_api_key_here    # free from Google AI Studio (aistudio.google.com)
# OPENAI_API_KEY=                          # uncomment when team shares the key

# Tomorrow: Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── Orchestrator ────────────────────────────────────────────────────────────
# The orchestration store is the SAME Neon DATABASE_URL above (generic orch_kv table,
# auto-created). No separate store config, no SQLite, no Supabase.

# External CRM connections (Settings → Integrations). Generic REST adapter.
CRM_TIMEOUT_SEC=15

# Chat360 voice dispatch
CHAT360_OUTBOUND_URL=https://app.chat360.io/api/voicebot/external/outbound
# Also used by services/telehub/apps/telehub/services/dispatcher.py for the
# outbound call request's Authorization header.
CHAT360_OUTBOUND_BEARER_TOKEN=
CHAT360_AUTH_COOKIE=csrftoken=your_csrftoken_here
DID_POOL=+917965314309
DID_CONCURRENCY=100

# Follow-up reliability (Pain A) + goal-adaptation capacity split (Pain B)
SCHEDULER_INTERVAL_SEC=60
FOLLOWUP_MAX_RETRIES=4
FOLLOWUP_BACKOFF_HOURS=4,24,48,72
FOLLOWUP_CAPACITY_RESERVE=0.5
