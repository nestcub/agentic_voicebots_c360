# LLM Provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Database (optional — defaults to intelligence_fabric.db in repo root)
DB_PATH=intelligence_fabric.db

# Tomorrow: Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── Orchestrator ────────────────────────────────────────────────────────────
# Store backend: memory | supabase | auto (auto = supabase if creds below are set)
ORCH_STORE=auto
ORCH_DB_PATH=orchestrator_state.db

# Supabase (shared orchestration store the dashboard reads). Leave blank for offline demo.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Chat360 voice dispatch
CHAT360_OUTBOUND_URL=https://app.chat360.io/api/voicebot/external/outbound
CHAT360_AUTH_COOKIE=csrftoken=your_csrftoken_here
DID_POOL=+917965314309
DID_CONCURRENCY=100

# Follow-up reliability (Pain A) + goal-adaptation capacity split (Pain B)
SCHEDULER_INTERVAL_SEC=60
FOLLOWUP_MAX_RETRIES=4
FOLLOWUP_BACKOFF_HOURS=4,24,48,72
FOLLOWUP_CAPACITY_RESERVE=0.5
